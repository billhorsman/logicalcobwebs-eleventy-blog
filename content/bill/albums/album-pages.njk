---
pagination:
  data: albums
  size: 1
  alias: slug
  addAllPagesToCollections: true
permalink: "/bill/albums/{{ slug }}/"
eleventyComputed:
  title: "{{ albums[slug].title | safe }}"
  description: "{{ albums[slug].title | safe }} ({{ albums[slug].year }}) by {{ albums[slug].artist | safe }}{% if top_albums.includes(slug) %} — number {{ top_albums.indexOf(slug) + 1 }} in Bill's top 100 albums{% endif %}"
---
{%- set album = albums[slug] %}
{%- set position = top_albums.indexOf(slug) + 1 %}
{%- set inTopFive = top_5_albums.includes(slug) %}

{%- if position %}
{%- set prevAlbum = albums[top_albums[position - 2]] if position > 1 %}
{%- set nextAlbum = albums[top_albums[position]] if position < top_albums.length %}
<nav class="albums-nav">
  <div class="prev">
    {%- if prevAlbum %}
      <a href="/bill/albums/{{ prevAlbum.slug }}/"><i class="fa-solid fa-chevron-left fa-xs"></i> Previous</a>
    {%- else %}
      <span><i class="fa-solid fa-chevron-left fa-xs"></i> Previous</span>
    {%- endif %}
  </div>
  <div>
    <a class="simple" href="/bill/albums/">{{ position }} / {{ top_albums.length }}</a>
  </div>
  <div class="next">
    {%- if nextAlbum %}
      <a href="/bill/albums/{{ nextAlbum.slug }}/">Next <i class="fa-solid fa-chevron-right fa-xs"></i></a>
    {%- else %}
      <span>Next <i class="fa-solid fa-chevron-right fa-xs"></i></span>
    {%- endif %}
  </div>
  <div class="hint">
    <span class="prev-hint">
      <span class="sr-only">Previous album:</span>
      {{ prevAlbum.title if prevAlbum else "Start of list" }}
    </span>
    <span class="next-hint">
      <span class="sr-only">Next album:</span>
      {{ nextAlbum.title if nextAlbum else "End of list" }}
    </span>
  </div>
</nav>
{%- endif %}

<article class="album">
  {%- if slug | albumCoverExists %}
  <img class="album-cover" src="/bill/albums/covers/{{ slug }}.jpg" alt="Cover of {{ album.title }} by {{ album.artist }}">
  {%- else %}
  <album-card-no-cover class="album-cover"><i class="fa-solid fa-record-vinyl"></i></album-card-no-cover>
  {%- endif %}

  <h1>{{ album.title }}</h1>

  <p class="album-artist">
    <strong>{{ album.artist }}</strong> · {{ album.year }}
  </p>

  {%- if album_notes[slug] %}
  <section class="album-note">
    {{ album_notes[slug] | markdown | safe }}
  </section>
  {%- endif %}

  {%- if inTopFive %}
    <p>This album is in my top {{ top_5_albums.length }} 🎉</p>
  {%- elseif top_albums.includes(slug) %}
    <p>This album is in my top {{ top_albums.length }}.</p>
  {%- endif %}

  {%- if album.tracks.length %}
  <section class="album-tracks">
    {%- for disc in album.tracks %}
    {%- if album.tracks.length > 1 %}
    <h2>Disc {{ loop.index }}{% if disc.title %} · {{ disc.title }}{% endif %}</h2>
    {%- endif %}
    <ol class="track-list">
      {%- for track in disc.tracks %}
      <li>
        <track-title>{{ track.title }}</track-title>
        {%- if track.length %}<track-length>{{ track.length }}</track-length>{% endif %}
      </li>
      {%- endfor %}
    </ol>
    {%- endfor %}
  </section>
  {%- endif %}

  {%- if album.spotify %}
  <p class="album-listen-wrap">
    <a class="album-listen" href="{{ album.spotify }}">
      <i class="fa-brands fa-spotify"></i>
      Listen on Spotify
    </a>
  </p>
  {%- endif %}
</article>
