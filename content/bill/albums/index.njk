---
title: Albums
permalink: /bill/albums/
---
<h1 class="visually-hidden">Albums</h1>

<section class="album-grid top-five">
  <h2>Top 5</h2>
  <div class="album-grid-cards">
    {%- for slug in top_5_albums %}
      {%- set album = albums[slug] %}
      <a href="/bill/albums/{{ slug }}/" class="album-card">
        <img src="/bill/albums/covers/{{ slug }}.jpg" alt="Cover of {{ album.title }} by {{ album.artist }}" loading="lazy">
        <span class="album-card-rank">{{ loop.index }}</span>
        <span class="album-card-title">{{ album.title }}</span>
        <span class="album-card-artist">{{ album.artist }}</span>
      </a>
    {%- endfor %}
  </div>
</section>

<section class="album-grid">
  <h2>Top {{ top_albums.length }}</h2>
  <div class="album-grid-cards">
    {%- for slug in top_albums %}
      {%- set album = albums[slug] %}
      <a href="/bill/albums/{{ slug }}/" class="album-card">
        <img src="/bill/albums/covers/{{ slug }}.jpg" alt="Cover of {{ album.title }} by {{ album.artist }}" loading="lazy">
        <span class="album-card-title">{{ album.title }}</span>
        <span class="album-card-artist">{{ album.artist }} · {{ album.year }}</span>
      </a>
    {%- endfor %}
  </div>
</section>
